<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow local LAN HTTP server for TV QR Code setup & local TV remote control -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
